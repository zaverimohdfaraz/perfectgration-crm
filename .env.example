# ─────────────────────────────────────────────────────────────────────────────
# Perfectgration CRM: environment variables
# Copy this file to .env.local for your computer, and enter the same values in
# Vercel → Project → Settings → Environment Variables for the live site.
# NEVER commit .env.local or share these values. See docs/BACKEND_SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# "api" = live system with the database. Leave empty (or "demo") for the demo with sample data.
NEXT_PUBLIC_DATA_MODE=api

# The address of the live site, without a trailing slash (used for upload links and request checks).
APP_URL=https://crm.yourdomain.com

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Put the database name before the "?".
MONGODB_URI=mongodb+srv://crm_app:YOUR_DB_PASSWORD@cluster0.xxxxx.mongodb.net/perfectgration?retryWrites=true&w=majority&appName=Cluster0

# Long random secret that signs sign-in sessions. Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Amazon S3 (private bucket). Use the keys of the IAM user that can only use this bucket.
AWS_REGION=me-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=perfectgration-crm-files

# ─── Optional: Meta Ads and Google Ads (see docs/ADS_SETUP.md). Leave empty and the CRM works without them. ───
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
META_APP_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_IDS=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Protects the nightly ads sync job (Vercel sends it automatically).
CRON_SECRET=

# Only for "npm run db:seed" (creates the first administrator). Remove ADMIN_PASSWORD afterwards.
ADMIN_NAME=Aun
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# Demo mode only (ignored when NEXT_PUBLIC_DATA_MODE=api):
# DEMO_ACCESS_CODE=choose-a-code
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
